# LINKORA Backend Configuration Template

# Server Settings
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
SECRET_KEY=replace-with-a-32-byte-hex-random-string
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:8000"]

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://linkora:linkora_secret@localhost:5432/linkora_db

# Object Storage (S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=linkora-shares
S3_REGION=us-east-1
S3_USE_SSL=false

# Upload & Rate Limits
MAX_UPLOAD_SIZE_BYTES=10737418240 # 10 GB limit per file
RATE_LIMIT_PER_MINUTE=100
MAX_DOWNLOAD_COUNT_DEFAULT=50
SHARE_TOKEN_EXPIRATION_HOURS_DEFAULT=48

# Update Security
PUBLIC_VERIFICATION_KEY=MIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEA0sample
